# VeraProb — Git Attributes
# Enforces UTF-8 encoding and LF line endings for all text files.
# Prevents Windows-1252/Latin-1 re-encoding on checkout.

# Default: detect text, normalize to LF
* text=auto eol=lf

# Dart source — explicit text, UTF-8, LF
*.dart text eol=lf working-tree-encoding=UTF-8 diff=dart

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.editorconfig text eol=lf

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.lock binary
