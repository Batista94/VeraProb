# Claude Code ignore file
# Prevents indexing of large/non-code directories to save tokens

node_modules/
build/
.dart_tool/
.git/
coverage/
*.log
tmp/
*.exe
*.bak
*.tmp
.DS_Store
Thumbs.db
.idea/
.vscode/
QWEN.MD
.qwen/

# Platform specific folders (Noise for most tasks)
android/
ios/
windows/
macos/
web/
linux/

# Generated files
*.g.dart
*.freezed.dart

# Backups
.claude_backup_*/
*.bak
*.original.md

# Kiro
.kiro/

# Noise
scanner_output.txt
pubspec.lock
.flutter-plugins*
test-output/
.env*

# Media & Fonts
assets/
*.ttf
*.otf
*.woff
*.woff2
*.png
*.jpg
*.jpeg
*.svg
*.ico
*.mp4

# Databases & Lockfiles
*.db
*.sqlite
deno.lock

# Supabase Local State
supabase/.temp/
supabase/.branches/

# Agent Memory & Scratch
brain/
scratch/
package-lock.json
tmp_*.dart
devtools_options.yaml
doc/

# Security Audit Logs (INV-28 — local only, never index)
.veraprob/
