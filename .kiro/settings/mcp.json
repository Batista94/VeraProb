{
  "mcpServers": {
    "fetch": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "uvx mcp-server-fetch"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @playwright/mcp@latest"
      ],
      "env": {},
      "autoApprove": [
        "browser_wait_for"
      ]
    },
    "supabase": {
      "type": "stdio",
      "command": "C:\\Users\\wes_b\\.local\\bin\\supabase-mcp-server.exe",
      "args": [],
      "env": {
        "SUPABASE_PROJECT_REF": "127.0.0.1:54321",
        "SUPABASE_DB_PASSWORD": "postgres",
        "SUPABASE_REGION": "sa-east-1"
      },
      "autoApprove": [
        "get_table_schema",
        "retrieve_logs",
        "get_schemas",
        "retrieve_migrations",
        "execute_postgresql",
        "get_tables",
        "get_management_api_spec",
        "get_auth_admin_methods_spec"
      ],
      "disabled": true
    },
    "github": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabledTools": [
        "create_issue",
        "create_pull_request",
        "list_issues",
        "update_issue",
        "add_issue_comment",
        "search_issues",
        "search_users",
        "get_issue",
        "create_or_update_file",
        "search_repositories",
        "create_repository",
        "get_file_contents",
        "push_files",
        "fork_repository",
        "create_branch",
        "list_commits",
        "search_code",
        "get_pull_request",
        "list_pull_requests",
        "create_pull_request_review",
        "merge_pull_request",
        "get_pull_request_files",
        "get_pull_request_status",
        "update_pull_request_branch",
        "get_pull_request_comments",
        "get_pull_request_reviews"
      ]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "autoApprove": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-memory"
      ],
      "env": {},
      "autoApprove": [
        "create_entities",
        "add_observations"
      ]
    },
    "gemini": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-google-search"
      ],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}"
      },
      "disabled": true
    }
  }
}