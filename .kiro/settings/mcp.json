{
  "mcpServers": {
    "playwright": { "command": "cmd", "args": ["/c", "npx -y @playwright/mcp@latest"] },
    "github": {
      "command": "cmd",
      "args": ["/c", "npx -y @modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "disabled": true
    },
    "postgres": {
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
      ],
      "autoApprove": ["query"],
      "disabled": true
    },
    "docker": { "command": "uvx", "args": ["mcp-server-docker"], "autoApprove": ["list_containers"] },
    "fetch": { "command": "uvx", "args": ["mcp-server-fetch"], "autoApprove": ["fetch"] },
    "memory": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./.agents/scripts/memory-proxy.ps1"
      ]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx -y @modelcontextprotocol/server-sequential-thinking"],
      "autoApprove": ["sequentialthinking"]
    }
  }
}