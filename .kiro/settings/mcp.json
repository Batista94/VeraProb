{
  "mcpServers": {
    "fetch": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "uvx mcp-server-fetch"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @playwright/mcp@latest"
      ],
      "env": {}
    },
    "supabase": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "set maptiler_key= && set environment= && set service_role_key= && supabase-mcp-server"
      ],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "github": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${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}"
      },
      "disabledTools": [
        "create_issue",
        "create_pull_request",
        "list_issues",
        "update_issue",
        "add_issue_comment",
        "search_issues",
        "search_users",
        "get_issue",
        "create_or_update_file",
        "search_repositories",
        "create_repository",
        "get_file_contents",
        "push_files",
        "fork_repository",
        "create_branch",
        "list_commits",
        "search_code",
        "get_pull_request",
        "list_pull_requests",
        "create_pull_request_review",
        "merge_pull_request",
        "get_pull_request_files",
        "get_pull_request_status",
        "update_pull_request_branch",
        "get_pull_request_comments",
        "get_pull_request_reviews"
      ]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "autoApprove": [
        "sequentialthinking"
      ]
    }
  }
}