{
  "name": "Forensic Secrets Scanner",
  "description": "Scanner de segredos e credenciais. Ativa apenas em main ou branches com PR aberto.",
  "version": "1",
  "when": {
    "type": "preCommit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Execute o scanner forense de segredos rodando 'python scripts/security/scan_secrets.py'. Se o script retornar exit 1, reporte as violações mascaradas e instrua o desenvolvedor a usar variáveis de ambiente. Não exiba o segredo real."
  }
}
