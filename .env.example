# =============================================================================
# VeraProb — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git (it's in .gitignore).
# =============================================================================

# --- INFRAESTRUTURA SUPABASE (LOCAL via `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=127.0.0.1:54321
SUPABASE_REGION=sa-east-1
SUPABASE_DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Chaves obtidas via `supabase status` após `supabase start`
# NOTA: Estas chaves são para o ambiente LOCAL. Nunca use em produção.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- INTELIGÊNCIA ARTIFICIAL ---
GEMINI_API_KEY=<your-gemini-api-key>

# --- NOTIFICAÇÕES E ALERTAS (TELEGRAM) ---
TELEGRAM_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# --- INTEGRAÇÃO GITHUB (opcional) ---
GITHUB_TOKEN=<your-github-pat>

# --- CONFIGURAÇÕES DE DESENVOLVIMENTO ---
SKIP_MFA_DEV=true
