# =============================================================================
# VeraProb — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git (it's in .gitignore).
# =============================================================================

# --- INFRAESTRUTURA SUPABASE (LOCAL via `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=127.0.0.1:54321
SUPABASE_REGION=sa-east-1
SUPABASE_DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Chaves obtidas via `supabase status` após `supabase start`
# Copie os valores reais do output do comando acima
SUPABASE_ANON_KEY=<copie de 'supabase status'>
SUPABASE_SERVICE_ROLE_KEY=<copie de 'supabase status'>

# --- INTELIGÊNCIA ARTIFICIAL ---
GEMINI_API_KEY=<your-gemini-api-key>

# --- NOTIFICAÇÕES E ALERTAS (TELEGRAM) ---
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<your-webhook-secret-min-32-chars-or-simulated>

# --- INTEGRAÇÃO GITHUB (opcional) ---
GITHUB_TOKEN=<your-github-pat>

# --- CONFIGURAÇÕES DE DESENVOLVIMENTO ---
SKIP_MFA_DEV=true
# Flutter Legal Gate bypass — requires BOTH ENV=dev AND this flag.
# Never enable for staging/prod UAT (see Legal Gate LGPD architecture plan).
# Pass to Flutter as: --dart-define=SKIP_LGPD_CONSENT_DEV=true
SKIP_LGPD_CONSENT_DEV=false
