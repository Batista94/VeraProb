# VeraProb - Hermetic Test Environment
FROM ubuntu:22.04

# Dependências básicas do Flutter
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    libglu1-mesa \
    libgtk-3-0 \
    libblkid1 \
    liblzma5 \
    python3 \
    postgresql-client \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 18 LTS (apt default is v12 which lacks optional chaining support)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Instala o Flutter 3.41.9
RUN git clone https://github.com/flutter/flutter.git -b 3.41.9 /opt/flutter

# CONFIGURAÇÃO DE BLINDAGEM:
# Instalamos ferramentas globais em /opt/dart-tools para que não sejam
# cobertas pelo volume de cache do projeto (/root/.pub-cache).
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/dart-tools/bin:${PATH}"
RUN PUB_CACHE=/opt/dart-tools dart pub global activate dart_code_metrics

# Pré-download dos artefatos
RUN flutter doctor

WORKDIR /app
